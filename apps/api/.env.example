PORT=4100
HOST=0.0.0.0
DATABASE_URL=postgres://gudex:gudex@localhost:5442/gudex
# Только для однократной настройки отдельной Neon live-БД. В рабочем deployment флаг false.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
LIVE_DATABASE_SETUP_ENABLED=false

# Токен бота из @BotFather. Вставляет владелец сам. Без него локально работает вход DEV_LOGIN.
TELEGRAM_BOT_TOKEN=
# Секрет для локальной разработки без бота (любая длинная строка).
JWT_SECRET=change-me-to-a-long-random-string
# Публичный HTTPS-адрес Mini App (на Vercel подставляется сам).
PUBLIC_URL=

# Включает dev-эндпоинты (симуляция депозита и покупки).
DEV_TOOLS=true
# Вход без Telegram — только локально (на Vercel игнорируется).
DEV_LOGIN=true

# mock — демо. upay — настоящий адаптер; записи отдельно включаются флагами ниже.
# CARD_PARTNER=upay требует DEV_TOOLS=false и три секрета входа ниже.
CARD_PARTNER=mock
# manual: анкеты проверяют админы, выпуск выполняют в UPay вручную; автоматический POST выпуска выключен.
# Требует ADMIN_TELEGRAM_IDS. Существующие неизвестные операции не переводятся в ручные.
CARD_ISSUANCE_MODE=automatic
UPAY_LOGIN=
UPAY_PASSWORD=
UPAY_TOTP_SECRET=
# Отдельный шестизначный Payment Password кабинета, не пароль входа и не TOTP.
UPAY_PAYMENT_PASSWORD=
UPAY_PRODUCT_ID=2040769880440840193
# ID группы клиентов UPay. Если не задан, допускается единственная default-группа кабинета.
UPAY_CUSTOMER_GROUP_ID=
# Оставить false до настройки платёжного пароля и отдельной чистой live-БД.
UPAY_WRITES_ENABLED=false
UPAY_KYC_ENABLED=false
# Реальные счета пополнения UPay: включать только с отдельной чистой live-БД.
UPAY_INVOICE_DEPOSITS_ENABLED=false
# Дополнительный сбор selfie; требования продукта также проверяются перед отправкой.
UPAY_KYC_REQUIRE_SELFIE=false
KYC_DOCUMENT_TTL_SECONDS=86400
UPAY_DEVICE_ID=WEB-GUDEX-Automation/1
UPAY_TIMEOUT_MS=8000
UPAY_SESSION_TTL_SECONDS=3600

# Отдельные серверные bearer secrets. Для OPS_API_TOKEN минимум 32 случайных символа.
# Без него /v1/ops/* и /v1/telegram/setup недоступны. Секреты не отправлять Mini App.
OPS_API_TOKEN=
CRON_SECRET=
JOB_DRAIN_MS=20000
JOB_POLL_MS=1000

# Тарифы GUDEX. Себестоимость проверяется чтением UPay перед отправкой и сверяется по квитанции.
CARD_PRODUCT_NAME=GUDEX Visa
CARD_ISSUE_FEE_USD=10
CARD_TOPUP_FEE_BPS=150
CARD_MIN_TOPUP_USD=10
MAX_CARDS_PER_USER=3
MIN_DEPOSIT=1

# Задержки заглушек, чтобы в приложении были видны статусы «в обработке».
MOCK_PARTNER_DELAY_MS=1500
KYC_MOCK_DELAY_MS=3000

# Лимиты карты у эмитента — только для экрана «Тарифы». Пусто — строка не показывается.
CARD_LIMIT_TX_USD=
CARD_LIMIT_DAY_USD=
CARD_LIMIT_MONTH_USD=

# Вывод на внешний кошелёк: комиссия сети и минимум по сетям.
WITHDRAW_FEES=TON:0.3,TRC20:2,BEP20:0.5,POLYGON:0.5,ERC20:5
WITHDRAW_MIN=TON:5,TRC20:10,BEP20:5,POLYGON:5,ERC20:20

# Доля пригласившего от маржи после фактического расхода UPay (2000 = 20%).
REFERRAL_SHARE_BPS=2000

# Ссылки: бот (для ссылок-приглашений), сайт, обменник, поддержка и канал (ники без @).
BOT_USERNAME=gudex_card_bot
SITE_URL=https://gudexchange.com
SUPPORT_USERNAME=
CHANNEL_USERNAME=

# Обменник WhiteBird внутри приложения: ссылка на скрипт SDK и ключи партнёра (выдаёт WhiteBird).
# Пока пусто — экран «Купить крипту» показывает «скоро».
# WHITEBIRD_SDK_URL по умолчанию уже указывает на их CDN — менять не нужно.
WHITEBIRD_MERCHANT_ID=
WHITEBIRD_MERCHANT_PASS=
WHITEBIRD_COLOR=#2E66E9

# Telegram ID администраторов через запятую: команда боту /notice включает плашку о сбоях.
# Свой ID можно узнать командой /id боту.
ADMIN_TELEGRAM_IDS=
